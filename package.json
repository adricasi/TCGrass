{
  "name": "tcgrass",
  "version": "0.1.0",
  "private": true,
  "description": "Collectible card game: photograph real things to earn illustrated cards, then trade with friends.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike": "node --env-file-if-exists=.env --import tsx scripts/spike-identify.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
