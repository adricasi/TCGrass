{
  "name": "tcgrass",
  "version": "0.1.0",
  "description": "Collectible card game: photograph real things to earn illustrated cards, then trade with friends.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adricasi/TCGrass.git"
  },
  "homepage": "https://tcgrass.duckdns.org/",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/server/db/migrations dist/server/db/ && vite build web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p test/ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike": "node --env-file-if-exists=.env --import tsx scripts/spike-identify.ts",
    "load": "node --import tsx scripts/load-captures.ts",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch src/server/main.ts",
    "dev:web": "vite web",
    "start": "node dist/server/main.js",
    "seed": "node --env-file-if-exists=.env --import tsx src/server/seed-cli.ts",
    "seed:prod": "node dist/server/seed-cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "preact": "^11.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
