# Copy to .env for local development and fill in values. Never commit .env.
# Variable names only; real secrets are set on the host, never in the repo.
APP_ENV=development
LOG_LEVEL=info

# Inference: any OpenAI-compatible Gemma endpoint (DO serverless, vLLM, Ollama) (REQ-012).
# Base URL up to and including /v1, e.g. Ollama: http://localhost:11434/v1
INFERENCE_BASE_URL=
INFERENCE_MODEL=
# Optional bearer key (secret); leave empty for a local Ollama.
INFERENCE_API_KEY=
# Minimum model confidence to mint a card, 0..1 (default 0.5).
IDENTIFY_MIN_CONFIDENCE=0.5
