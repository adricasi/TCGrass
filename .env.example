# Copy to .env for local development. Never commit .env.
# On the Droplet, .env lives next to compose.yaml (mode 600) and is passed to the API only.

# OpenAI-compatible Gemma endpoint (DO serverless, vLLM or Ollama), e.g. http://localhost:11434/v1
INFERENCE_BASE_URL=
INFERENCE_MODEL=
# Optional; secret. Leave empty for a local Ollama.
INFERENCE_API_KEY=
# Minimum model confidence to mint a card (default 0.5)
IDENTIFY_MIN_CONFIDENCE=
# Expansion id to play (default everyday-nature)
ACTIVE_EXPANSION=
# SQLite file (default .dev/tcgrass.db locally)
DATABASE_PATH=
# Request log file on the volume (optional)
LOG_FILE_PATH=
# Caddy hostname, e.g. 203-0-113-7.sslip.io
PUBLIC_HOSTNAME=
PORT=
LOG_LEVEL=info
