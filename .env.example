# Copy to .env for local development and fill in values. Never commit .env.
# Variable names only; real secrets are set on the host, never in the repo.
APP_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Inference: any OpenAI-compatible Gemma endpoint (DO serverless, vLLM, Ollama) (REQ-012).
# Base URL up to and including /v1, e.g. Ollama: http://localhost:11434/v1
INFERENCE_BASE_URL=
INFERENCE_MODEL=
# Optional bearer key (secret); leave empty for a local Ollama.
INFERENCE_API_KEY=
# Minimum model confidence to mint a card, 0..1 (default 0.5).
IDENTIFY_MIN_CONFIDENCE=0.5

# Deployment (compose.yaml, docs/deploy.md): read by Compose only; the API ignores them.
# In the container Compose also fixes PORT, DATABASE_PATH, LOG_FILE_PATH and TRUST_PROXY.
# Hostname Caddy serves and gets a certificate for, e.g. 203-0-113-7.sslip.io (localhost locally).
PUBLIC_HOSTNAME=localhost
# Host directory for the DB and logs, writable by uid 1000 (on the Droplet: on the Volume).
DATA_DIR=./data

# API server.
# Expansion folder under expansions/ to play with.
ACTIVE_EXPANSION=everyday-nature
PORT=3000
# Optional: also append JSON logs to this file (on the volume in production).
LOG_FILE_PATH=
# SQLite file. Local dev: .dev/ (git-ignored). Production: on the Compose volume.
DATABASE_PATH=.dev/tcgrass.db
# true only behind Caddy (production): rate limits then use X-Forwarded-For. Leave false locally.
TRUST_PROXY=false
# Daily model-call caps (NFR-012): overall per UTC day, and per player per UTC day.
# Set INFERENCE_DAILY_CALL_LIMIT=0 to pause all captures (kill switch).
INFERENCE_DAILY_CALL_LIMIT=3000
CAPTURES_PER_PLAYER_PER_DAY=30
