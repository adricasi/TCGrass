[Unit]
Description=Block containers from the DigitalOcean metadata service (ADR 0008)
# Before Docker, so restart-policy containers never get a window to read user data, which holds
# the registry pull credentials. The raw table sees container traffic in PREROUTING; the host's
# own requests (cloud-init) use OUTPUT and are not affected. Docker doesn't manage this rule.
Before=docker.service
DefaultDependencies=no
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -t raw -C PREROUTING -d 169.254.169.254/32 -j DROP 2>/dev/null || iptables -t raw -I PREROUTING -d 169.254.169.254/32 -j DROP'

[Install]
WantedBy=multi-user.target
RequiredBy=docker.service
